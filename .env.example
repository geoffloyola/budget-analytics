# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by the CSV import script and /import page. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Local only (not needed on Netlify): lets `npm run db:migrate` set up the
# database. Supabase → Project Settings → Database → Connection string →
# Session pooler, with your database password filled in.
SUPABASE_DB_URL=

# Server-only: powers the AI Insights page.
ANTHROPIC_API_KEY=

# The district the "District Lens" page focuses on. Must match the
# `province` / `district` values in your district_items CSV.
NEXT_PUBLIC_HOME_PROVINCE=Bataan
NEXT_PUBLIC_HOME_DISTRICT=2nd District
# Optional: the district's municipalities, comma-separated, exactly as DBM
# spells them (e.g. "Balanga,Orion"). Empty = whole province.
NEXT_PUBLIC_HOME_MUNICIPALITIES=
